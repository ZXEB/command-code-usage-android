<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur 要求 minSdk 33；此处显式声明，避免合并告警 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CcUsageApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CcUsage"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <!--
          小米小部件版本号（官方规范 §10）。
          必须放在 <application> 下，而不是某个 provider 下；
          小部件功能有变动就要 +1，否则有被下线风险。
        -->
        <meta-data
            android:name="miuiWidgetVersion"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|layoutDirection|locale|smallestScreenSize|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ============================ 4×2 小组件（主） ============================
          逐条对齐小米《小部件技术规范与系统能力说明》：
          - android:process=":widgetProvider"   -> §1.3 独立进程
          - miuiWidget = true                    -> §4   小米小部件标识
          - miuiWidgetRefresh = exposure         -> §2.1 曝光刷新（系统已去掉定时刷新）
          - miuiWidgetRefreshMinInterval         -> §2.1 曝光刷新间隔（毫秒，最短 10s）
          - miui.appwidget.action.APPWIDGET_UPDATE -> §2.2 曝光刷新广播
          android:label 与 2×2 保持一致 -> §4 同功能不同尺寸会在详情页聚合
        -->
        <receiver
            android:name=".widget.UsageWidgetProvider"
            android:label="@string/widget_label"
            android:process=":widgetProvider"
            android:exported="false">
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget_4x2" />
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="60000" />
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- ============================ 2×2 小组件（精简） ============================ -->
        <receiver
            android:name=".widget.CompactWidgetProvider"
            android:label="@string/widget_label"
            android:process=":widgetProvider"
            android:exported="false">
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget_2x2" />
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="60000" />
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
        </receiver>

        <!--
          WorkManager 的组件显式声明在 :widgetProvider 进程。

          这么做是为了让「小组件刷新」全程不拉起应用主进程 —— 曝光刷新触发的联网更新
          由该进程内的 CoroutineWorker 完成，符合小米小部件规范 §1「Widget 进程只能运行
          Widget 内容准备和刷新相关的逻辑」，也满足其 ≤35M 的内存约束。

          这里用**显式声明**而不是 tools:node="merge"：后者只能覆盖已有节点的属性，
          无法给 androidx.startup 自动生成的 provider 添加 android:process。
          显式声明会替换掉库里的节点，因此 authorities 必须与库保持一致
          （${applicationId}.androidx-startup）。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            android:process=":widgetProvider" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:process=":widgetProvider"
            android:foregroundServiceType="shortService"
            tools:node="merge" />

    </application>

</manifest>
