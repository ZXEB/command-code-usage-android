<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur 要求 minSdk 33；此处显式声明，避免合并告警 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CcUsageApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CcUsage"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <!--
          小米小部件版本号（官方规范 §10）。
          必须放在 <application> 下，而不是某个 provider 下；
          小部件功能有变动就要 +1，否则有被下线风险。
        -->
        <meta-data
            android:name="miuiWidgetVersion"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|layoutDirection|locale|smallestScreenSize|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ============================ 4×2 小组件（主） ============================
          逐条对齐小米《小部件技术规范与系统能力说明》与《小部件审核规范》：
          - miuiWidget = true                    -> §4   小米小部件标识
          - miuiWidgetRefresh = exposure         -> §2.1 曝光刷新（系统已去掉定时刷新）
          - miuiWidgetRefreshMinInterval         -> §2.1 曝光刷新间隔（毫秒，最短 10s）
          - miui.appwidget.action.APPWIDGET_UPDATE -> §2.2 曝光刷新广播
          android:label 与 2×2 保持一致 -> §4 同功能不同尺寸会在详情页聚合

          ⚠️ android:exported 必须是 true：
          系统由 AppWidgetServiceImpl.updateProvidersForPackageLocked() 通过
          queryIntentReceivers(ACTION_APPWIDGET_UPDATE) 枚举小组件，该方法只带
          GET_META_DATA / MATCH_DEBUG_TRIAGED_MISSING 等标记，**不会带上未导出组件**。
          设成 false 时 AppWidgetManager.getAppWidgetIds 仍能工作（读实例看似正常），
          但桌面「添加小部件」列表根本解析不到这个应用。
          这也是官方 appwidget 模板的写法。

          ⚠️ 关于 android:process=":widgetProvider"：
          小米规范 §1.3 确实要求小组件使用 :widgetProvider 独立进程，但**审核规范
          第五节同时要求该进程内存 ≤40M**。我们的小组件 RemoteViews 布局里含
          ProgressBar / Layer-List drawable，渲染线程在部分 HyperOS 版本上会在
          独立进程里因内存压力拿不到足够的图形缓冲，表现为卡片空白或干脆不显示。
          权衡后**不设置 process**，让小组件跑在默认（主）进程：
          本应用的渲染链路只读 SharedPreferences，内存占用极小，稳定性优先。
          如果日后要上架小米小部件中心，再按 §1.3 开启并单独压测内存。
        -->
        <receiver
            android:name=".widget.UsageWidgetProvider"
            android:label="@string/widget_label"
            android:exported="true">
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget_4x2" />
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="60000" />
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- ============================ 2×2 小组件（精简） ============================ -->
        <receiver
            android:name=".widget.CompactWidgetProvider"
            android:label="@string/widget_label"
            android:exported="true">
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget_2x2" />
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="60000" />
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
        </receiver>

        <!--
          WorkManager 的 SystemForegroundService 也放进 :widgetProvider 进程，
          让小组件刷新全程不拉起应用主进程（小米规范 §1）。

          这里**故意不把 androidx.startup.InitializationProvider 挪进 widget 进程**，
          虽然那样更"干净"，但代价很大：
          该 provider 负责触发 WorkManagerInitializer 等初始化。一旦它运行在
          :widgetProvider 进程而只有部分 initializer 生效，WorkManager 在主进程会
          初始化失败，`WorkManager.getInstance(context)` 直接抛
          IllegalStateException("WorkManager is not initialized properly")。
          那会让设置页里的「添加桌面小组件」按钮在调用时就崩掉 —— 表现正好是"点了没反应"。
          保持它在默认（主）进程，只在 Session 流程里按需触发 widget 刷新即可。
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="shortService"
            tools:node="merge" />

    </application>

</manifest>
