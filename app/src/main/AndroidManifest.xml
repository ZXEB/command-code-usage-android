<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur 要求 minSdk 33；此处显式声明，避免合并告警 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CcUsageApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CcUsage"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|layoutDirection|locale|smallestScreenSize|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ============================ 4×2 小组件（主） ============================

          这里是**标准 Android 原生小部件**，不是「小米小部件」。

          为什么去掉 miuiWidget 标识：依据小米《小部件提交审核与上传操作指南》
          （dev.mi.com/xiaomihyperos/documentation/detail?pId=1588）——
          「只有符合审核规范的小部件才会被【小部件中心】收录」，且必须先把 App
          上架小米应用商店、再上传到 widget.xiaomi.com 并通过审核；
          而「若仅适配安卓原生小部件则无需通过小米审核，可自行按照安卓规范适配」，
          用户通过「安卓小部件」入口添加。

          本应用是侧载分发（GitHub Actions 出包），不走小米应用商店、也不会去做
          widget.xiaomi.com 登记。小米文档对「已登记小米小部件」和「原生小部件」给的是
          两条并行路径：「若仅适配安卓原生小部件则无需通过小米审核」。既然不做登记，
          就不该声明这些小米专有标识——它们只对登记过的小部件有意义。

          ⚠️ 注意：此前曾把「声明 miuiWidget 导致原生入口也搜不到」当成根因，
          但这一点**没有找到官方或社区实证**（小米文档只说两条路径并行，AOSP 的
          Provider 枚举也不读 miuiWidget）。所以这里按「侧载只走原生路径」的正确
          写法来声明，而不是声称它一定能解决搜不到的问题。若仍添加不了，
          请走桌面「添加小部件 → 安卓小部件」入口确认。

          android:label 两个尺寸保持一致，系统据此把同功能不同尺寸聚合展示。
          label 用「用量小组件」（5 个汉字）：小米要求小部件名称 2–8 个汉字，
          且不能与应用名相同（应用名是「CC 用量」）。

          ⚠️ android:exported 保持 true：
          系统由 AppWidgetServiceImpl.updateProvidersForPackageLocked() 通过
          queryIntentReceivers(ACTION_APPWIDGET_UPDATE) 枚举小组件。
          exported=true 是官方 appwidget 模板与各大桌面的稳妥写法，
          同时不影响任何安全边界（该 receiver 只处理系统广播）。

          ⚠️ 不设置 android:process=":widgetProvider"：
          小米规范 §1.3 要求（仅针对上架小米小部件中心的场景）。本项目不上架，
          而独立进程会带来实际风险：WorkManager / 各 androidx.startup initializer
          默认只在主进程初始化，把小组件挪进 :widgetProvider 后
          `WorkManager.getInstance()` 会抛 "WorkManager is not initialized properly"，
          设置页的「添加到桌面」按钮会直接崩掉（表现正是"点了没反应"）。
          小组件渲染链路只读 SharedPreferences、不联网，跑在主进程开销极小。
        -->
        <!-- ============================ 4×4 小组件（详细） ============================
             三个用量窗口各一张卡片：标题 + 已用% + 进度条 + 剩余额度 + 重置时间。
             其余声明约定（exported / label / 不设独立进程等）见上方 4×2 的说明。 -->
        <receiver
            android:name=".widget.DetailedWidgetProvider"
            android:label="@string/widget_label"
            android:exported="true">
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget_4x4" />
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.UsageWidgetProvider"
            android:label="@string/widget_label"
            android:exported="true">
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget_4x2" />
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 澎湃桌面可能推送曝光刷新广播；声明它不会有害，
                     收到时顺手重绘一次（刷新路径多一条），见 BaseUsageWidgetProvider.onReceive -->
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- ============================ 2×2 小组件（精简） ============================ -->
        <receiver
            android:name=".widget.CompactWidgetProvider"
            android:label="@string/widget_label"
            android:exported="true">
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget_2x2" />
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
        </receiver>

        <!--
          WorkManager 的 SystemForegroundService 也放进 :widgetProvider 进程，
          让小组件刷新全程不拉起应用主进程（小米规范 §1）。

          这里**故意不把 androidx.startup.InitializationProvider 挪进 widget 进程**，
          虽然那样更"干净"，但代价很大：
          该 provider 负责触发 WorkManagerInitializer 等初始化。一旦它运行在
          :widgetProvider 进程而只有部分 initializer 生效，WorkManager 在主进程会
          初始化失败，`WorkManager.getInstance(context)` 直接抛
          IllegalStateException("WorkManager is not initialized properly")。
          那会让设置页里的「添加桌面小组件」按钮在调用时就崩掉 —— 表现正好是"点了没反应"。
          保持它在默认（主）进程，只在 Session 流程里按需触发 widget 刷新即可。
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="shortService"
            tools:node="merge" />

    </application>

</manifest>
