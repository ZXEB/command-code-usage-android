<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 小组件配色。深色模式：半透明深色卡片，桌面壁纸仍能透出一点 -->
    <color name="widget_background_color">#F21C1C1E</color>
    <color name="widget_text_primary">#E6FFFFFF</color>
    <color name="widget_text_secondary">#99FFFFFF</color>
    <color name="widget_text_tertiary">#66FFFFFF</color>
    <color name="widget_progress_track">#33FFFFFF</color>
    <color name="widget_progress_fill">#5C9DFF</color>

    <!-- 4×4 内层卡片（深色）：比外框略亮，形成「卡片叠卡片」的层次 -->
    <color name="widget_card_inner_color">#14FFFFFF</color>

    <!-- 分档配色（深色模式）：同色相提亮，保证在深色卡片上仍可读 -->
    <color name="widget_ok">#4CC36A</color>
    <color name="widget_warn">#F5B942</color>
    <color name="widget_error">#FF6B6B</color>
</resources>
